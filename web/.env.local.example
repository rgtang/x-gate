GATEWAY_ADMIN_URL=http://localhost:8413

NEXT_PUBLIC_GATEWAY_ADMIN_URL=http://localhost:8413



# base (default, mainnet) | base-sepolia (testnet)

NEXT_PUBLIC_NETWORK=base

NEXT_PUBLIC_RPC_URL=https://mainnet.base.org

# Legacy alias — still read if NEXT_PUBLIC_RPC_URL is unset

NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://mainnet.base.org

NEXT_PUBLIC_EXPLORER_URL=https://basescan.org

# Optional UI override — defaults to "Base" or "Base Sepolia" from NETWORK

# NEXT_PUBLIC_NETWORK_LABEL=Base



# On-Chain Audit — copy these to Vercel (Production + Preview)

NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

NEXT_PUBLIC_DEPLOY_BLOCK=0

NEXT_PUBLIC_AGENT_ADDRESS=0x000000000000000000000000000000000000000000



# Base Sepolia testnet profile (example):

# NEXT_PUBLIC_NETWORK=base-sepolia

# NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org

