# ─── LLM (OpenAI-compatible, DeepSeek default) ───────────────────────────────
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your_api_key_here
LLM_MODEL=deepseek-chat

# ─── Chain ───────────────────────────────────────────────────────────────────
# base-sepolia (default, testnet) | base (mainnet — use with care)
NETWORK=base-sepolia
RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://sepolia.base.org
EXPLORER_URL=https://sepolia.basescan.org
WALLET_PRIVATE_KEY=0xyour_testnet_private_key_here
WALLET_ADDRESS=0xyour_wallet_address_here

# PaymentReceipt.sol — redeploy per network; update address + web NEXT_PUBLIC_*
PAYMENT_RECEIPT_ADDRESS=0x0000000000000000000000000000000000000000
PAYEE_ADDRESS=0xyour_gateway_wallet_here

# ─── x-gate Gateway ──────────────────────────────────────────────────────────
GATEWAY_BASE_URL=http://localhost:8402

# stub = LLM real + fake X-Payment header (no USDC needed)
# live = real USDC transfer (gateway VERIFIER_MODE=live)
AGENT_DEMO_MODE=stub

# USDC — must match gateway USDC_ADDRESS (defaults per NETWORK if unset)
# Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base:    0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ─── CROO Agent Protocol (CAP) ───────────────────────────────────────────────
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws
CROO_SDK_KEY_PROVIDER=croo_sk_your_provider_key
# MUST be a different Agent's key (not the provider's)
CROO_SDK_KEY_REQUESTER=croo_sk_your_requester_key
CROO_SERVICE_ID=svc-your-service-id

# pay | skip — preset for npm run croo:demo (case 1 vs case 2)
CROO_DEMO_CASE=pay
CROO_DEMO_TIMEOUT_MS=180000

# Optional — defaults to gateway/data/cap-orders.json
# CAP_ORDERS_FILE=../gateway/data/cap-orders.json

# ─── Base mainnet profile (example — uncomment and align all three packages) ─
# NETWORK=base
# RPC_URL=https://mainnet.base.org
# BASE_RPC_URL=https://mainnet.base.org
# EXPLORER_URL=https://basescan.org
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
