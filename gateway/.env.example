UPSTREAM_URL=https://httpbin.org    # demo upstream — swap for your own service

# base-sepolia (default) | base (mainnet)
NETWORK=base-sepolia
RPC_URL=https://sepolia.base.org
EXPLORER_URL=https://sepolia.basescan.org
GATEWAY_WALLET=0xyour_testnet_wallet_here
GATEWAY_PRIVATE_KEY=0xyour_testnet_private_key_here   # TESTNET ONLY — never mainnet
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
PROXY_PORT=8402
ADMIN_PORT=8403
# Return local JSON for paid /api/* (avoids httpbin 503 in demos). Set false to forward all traffic.
BUILTIN_API=true

# stub = demo (any 0x X-Payment header) | live = verify USDC Transfer on-chain
VERIFIER_MODE=stub

# Base mainnet profile (example):
# NETWORK=base
# RPC_URL=https://mainnet.base.org
# EXPLORER_URL=https://basescan.org
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
